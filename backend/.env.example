# Copy to .env and fill in. .env is gitignored.

# Google Gemini API keys -- https://aistudio.google.com/apikey
#
# Free-tier quota is metered per PROJECT, per model, per day, and a key belongs
# to a project. So a key from a DIFFERENT Google account is an independent
# daily allowance, not a second slice of the same one. Three keys against seven
# models is 21 independent allowances, and the pipeline rotates through them:
# keys first, then models, so it stays on the preferred model as long as any
# key still has quota for it.
#
# Only the first is required. Leave the others blank if you have only one.
# GET /health reports how many slots remain.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Overflow, if you have more than three. Comma-separated, no spaces.
GEMINI_API_KEYS=

# Models
GEMINI_MODEL=gemini-3.6-flash
# Free-tier quota is per model PER DAY, so one model name is one point of
# failure. When the active model's daily quota is spent the pipeline rotates
# to the next name here and carries on. Check /health to see pool state.
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# SQLite database path (relative to /backend)
DATABASE_PATH=factpulse.db

# Where uploaded PDFs are kept, so grounding can re-open them later.
UPLOAD_DIR=uploads
# Rendered page images, cached by document hash.
PAGE_CACHE_DIR=page_cache
# Per-run timing log (ingest_log.jsonl) lives here.
STORAGE_DIR=storage
# Pixels per PDF point for rendered pages. bbox coords in /evidence match this.
PAGE_RENDER_SCALE=2.0
MAX_UPLOAD_MB=50

# Extraction. Facts below the confidence threshold are kept but queued for
# review rather than dropped.
EXTRACT_ON_UPLOAD=true
# Relate each document's facts to the rest of the corpus after extraction.
LINK_ON_UPLOAD=true
# Retries for transient 503/429 model responses, with exponential backoff.
EXTRACTION_MAX_ATTEMPTS=4
# Concurrent model calls. Free-tier RPM caps bind before ~6 helps.
EXTRACTION_CONCURRENCY=5
REVIEW_CONFIDENCE_THRESHOLD=0.9

# Chunking. Token counts are estimated (~4 chars/token), not tokenizer-exact.
CHUNK_MAX_TOKENS=900
CHUNK_OVERLAP_TOKENS=120

# API
API_HOST=127.0.0.1
API_PORT=8000

# CORS. Comma-separated, no spaces -- lets a deployed backend serve both the
# local dev server and the deployed frontend at once.
FRONTEND_ORIGIN=http://localhost:3000
