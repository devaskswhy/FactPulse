# Copy to .env and fill in. .env is gitignored.

# Google Gemini API key -- https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# SQLite database path (relative to /backend)
DATABASE_PATH=factpulse.db

# Where uploaded PDFs are kept, so grounding can re-open them later.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# Extraction. Facts below the confidence threshold are kept but queued for
# review rather than dropped.
EXTRACT_ON_UPLOAD=true
REVIEW_CONFIDENCE_THRESHOLD=0.5

# Chunking. Token counts are estimated (~4 chars/token), not tokenizer-exact.
CHUNK_MAX_TOKENS=900
CHUNK_OVERLAP_TOKENS=120

# API
API_HOST=127.0.0.1
API_PORT=8000

# CORS: the Next.js dev server
FRONTEND_ORIGIN=http://localhost:3000
